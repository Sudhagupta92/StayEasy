# StayEasy Server Environment Configuration Example
# Copy this file to .env and configure your environment-specific values

NODE_ENV=development
PORT=5000

# ==============================================================================
# Database Configuration (100% Persistent across system restarts & shutdowns)
# ==============================================================================
# Option 1: Local Persistent MongoDB (Default - Saved to server/data/db)
# Powered by WiredTiger disk engine on port 27017. Auto-starts with npm run dev or npm run db.
MONGODB_URI=mongodb://127.0.0.1:27017/stayeasy

# Option 2: MongoDB Atlas Cloud Database (Recommended for Production & Multi-Device Sync)
# Format: mongodb+srv://<username>:<password>@<cluster-domain>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Setup steps:
# 1. Sign up at https://www.mongodb.com/cloud/atlas and create a free M0 cluster.
# 2. In "Database Access", create a database user and remember the password.
# 3. In "Network Access", add IP Address -> "0.0.0.0/0" (Allow access from anywhere).
# 4. In "Database" -> "Connect" -> "Drivers" -> Copy connection string and paste below:
# MONGODB_URI=mongodb+srv://stayeasy_admin:YourStrongPassword123@cluster0.abcde.mongodb.net/stayeasy?retryWrites=true&w=majority

# ==============================================================================
# Security & CORS Configuration
# ==============================================================================
# Supports comma-separated origins. In development, any localhost port is automatically allowed.
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5174

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Python AI Service Gateway Configuration (Phase 9+)
AI_SERVICE_URL=http://localhost:8000
